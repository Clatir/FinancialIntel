  "exclude": ["tests/unit/data-store.test.ts", "tests/unit/import-replan.test.ts", "tests/unit/operations-state.test.ts", "tests/unit/loan-close.test.ts", "tests/unit/machine-store.test.ts", "tests/unit/wealth-memo.test.ts", "tests/unit/sensor-inputs.test.ts", "tests/unit/cargo-actions.test.ts", "tests/unit/intel-v-store.test.ts"]
