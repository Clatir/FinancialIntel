{
  "name": "financial-intel",
  "productName": "Financial Intel",
  "version": "1.14.0",
  "description": "Osobisty budżet kapitana okrętu – Financial Intel",
  "private": true,
  "author": "Financial Intel",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/check-node.mjs",
    "build": "electron-vite build",
    "prestart": "node scripts/check-node.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dev:mobile": "vite --config vite.mobile.config.mts",
    "build:mobile": "vite build --config vite.mobile.config.mts",
    "build:mobile:e2e": "vite build --config vite.mobile.config.mts --mode e2e",
    "test:e2e:mobile": "npm run build:mobile:e2e && playwright test -c playwright.mobile.config.ts",
    "cap:sync": "npm run build:mobile && cap sync ios"
  },
  "devDependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "6.0.3",
    "cmdk": "^1.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lightweight-charts": "^5.2.1",
    "luxon": "^3.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ulid": "^3.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
